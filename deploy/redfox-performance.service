[Unit]
Description=Red Fox frozen performance ledger ingestion
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/red-fox-market-dynamics
ExecStart=/usr/bin/flock -n /var/lock/redfox-performance.lock /opt/red-fox-market-dynamics/.venv/bin/python /opt/red-fox-market-dynamics/performance_ledger.py
User=root

