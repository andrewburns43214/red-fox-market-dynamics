[Unit]
Description=Refresh verified Red Fox Team Intelligence
ConditionPathExists=/var/lib/redfox-history/private/history.sqlite3

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/red-fox-market-dynamics
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=19
CPUWeight=5
CPUQuota=12%
IOSchedulingClass=idle
IOWeight=5
MemoryMax=175M
# Full historical coverage can take over a minute at the existing CPU cap.
# The publisher lock is checked throughout collection and market processing.
TimeoutStartSec=90
UMask=0022
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# SQLite may need to recreate WAL coordination files even for mode=ro readers.
# Keep the archive database itself read-only inside the service namespace.
ReadWritePaths=/var/lib/redfox-team-intelligence /var/lib/redfox-history/private
ReadOnlyPaths=/var/lib/redfox-history/private/history.sqlite3
ExecCondition=/usr/bin/flock -sn /var/lock/redfox_run.lock /usr/bin/true
ExecStart=/opt/red-fox-market-dynamics/.venv/bin/python team_intelligence.py
