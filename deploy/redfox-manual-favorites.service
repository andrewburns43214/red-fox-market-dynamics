[Unit]
Description=Red Fox owner-only Favorite controls
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/red-fox-market-dynamics
ExecStart=/opt/red-fox-market-dynamics/.venv/bin/python /opt/red-fox-market-dynamics/manual_favorite_server.py
Restart=on-failure
RestartSec=2
StateDirectory=redfox-manual-favorites
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
